{
    "name": "gosuccess/easybill-api",
    "description": "A modern, strongly-typed PHP client for the easybill REST API with built-in rate limiting.",
    "type": "library",
    "license": "MIT",
    "keywords": ["easybill", "api", "client", "rest", "invoicing", "psr-18"],
    "homepage": "https://github.com/gosuccess/easybill-api",
    "authors": [
        {
            "name": "Paul Gossen",
            "email": "paul@gosuccess.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.68",
        "php-http/mock-client": "^1.6",
        "nyholm/psr7": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "Gosuccess\\Easybill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Gosuccess\\Easybill\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
