{
    "name": "gosuccess/easybill-api",
    "description": "A modern, strongly-typed PHP client for the easybill REST API with built-in rate limiting.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "easybill",
        "api",
        "client",
        "rest",
        "invoicing",
        "psr-18"
    ],
    "homepage": "https://github.com/gosuccess/easybill-api",
    "authors": [
        {
            "name": "GoSuccess GmbH",
            "email": "paul@gosuccess.io"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.68"
    },
    "autoload": {
        "psr-4": {
            "GoSuccess\\Easybill\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GoSuccess\\Easybill\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "stan": "phpstan analyse",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": [
            "@cs",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
